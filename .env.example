# Copy to .env.local for local development. Real values live in Vercel → Project → Settings → Environment Variables.
# Never commit real secrets.

# --- Email (Resend) ---
# Without RESEND_API_KEY the site runs in log-only mode: emails are printed to the server console.
RESEND_API_KEY=
RESEND_FROM="Car Bot <hello@getcarbot.co>"
LEAD_NOTIFY_EMAIL=
# Falls back to LEAD_NOTIFY_EMAIL when empty.
PARTNER_NOTIFY_EMAIL=
# Resend segment (formerly "audience") IDs. Optional.
RESEND_AUDIENCE_ID=
RESEND_PARTNER_AUDIENCE_ID=

# --- Webhooks (optional; your automation that runs the searches) ---
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
PARTNER_WEBHOOK_URL=

# --- Rate limiting (optional; in-memory fallback when empty) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Public ---
NEXT_PUBLIC_WA_NUMBER=38978662817
NEXT_PUBLIC_SITE_URL=https://getcarbot.co

# --- Partner program ---
# none | dub | tolt | firstpromoter | rewardful
AFFILIATE_PROVIDER=none
# "Partner login" link in header/footer. Hidden when empty. Must be https://
PARTNER_PORTAL_URL=
# Provider keys, only for the provider you pick:
DUB_API_KEY=
TOLT_API_KEY=
FIRSTPROMOTER_API_KEY=
FIRSTPROMOTER_ACCOUNT_ID=
REWARDFUL_API_SECRET=

# --- Legal placeholders (shown as {{TOKEN}} on /privacy, /terms, /cookies until set) ---
LEGAL_ENTITY=
LEGAL_ADDRESS=
LEGAL_COMPANY_NUMBER=
LEGAL_DPO_EMAIL=
LEGAL_CONTACT_EMAIL=
LEGAL_TAX_NOTE=
